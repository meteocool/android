<resources>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <style name="MapControl">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/map_control_spacing</item>
        <item name="fabSize">mini</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="tint">?attr/colorOnSurface</item>
    </style>

    <!-- The settings sliders in the switches' turquoise rather than the black primary. -->
    <style name="ThemeOverlay.Meteocool.Slider" parent="">
        <item name="colorPrimary">@color/turquoise_cloud_0</item>
    </style>

</resources>
