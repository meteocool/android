<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/mapRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        tools:context=".ui.map.WebFragment">

    <!-- The WebView is created in code so a crashed renderer can be replaced. -->
    <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    <LinearLayout
            android:id="@+id/controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/map_control_margin"
            android:layout_marginEnd="@dimen/map_control_margin"
            android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/layers"
                style="@style/MapControl"
                android:contentDescription="@string/map_layers"
                android:enabled="false"
                app:srcCompat="@drawable/ic_layer" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/settings"
                style="@style/MapControl"
                android:contentDescription="@string/title_settings"
                app:srcCompat="@drawable/ic_settings" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/locateMe"
                style="@style/MapControl"
                android:contentDescription="@string/location_button"
                app:srcCompat="@drawable/ic_location_off" />
    </LinearLayout>

    <!-- "Trying again" while the map keeps failing to load. Not a button and
         takes no touches: MapRecovery retries on its own. -->
    <com.google.android.material.card.MaterialCardView
            android:id="@+id/loadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="32dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            tools:visibility="visible">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorSize="20dp"
                    app:trackThickness="2dp" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/map_load_failed"
                    android:textAppearance="?attr/textAppearanceBody2" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
